<Window x:Class="BasicMvvm.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BasicMvvm.Views"
        xmlns:localVms="clr-namespace:BasicMvvm.ViewModels"
        d:DataContext="{d:DesignInstance Type=localVms:MainWindowViewModel}"
        mc:Ignorable="d"
        Title="Page Navigation he" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <ContentControl Grid.Row="0" Content="{Binding CurrentPageViewModel}" VerticalAlignment="Center" />
        
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" 
                   Grid.Row="1" Text="{Binding DataModel.Data}" FontSize="16" FontWeight="Bold" Margin="10" />
    </Grid>
</Window>
